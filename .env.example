[TEMPLATE]
# ---------------------------------------------------------------------------
# LUMENOIR backend configuration
# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never put real secrets in this example file.
# ---------------------------------------------------------------------------

# ---- upload validation ----------------------------------------------------

# Maximum accepted upload size in bytes (default: 10 MB).
LUMENOIR_MAX_UPLOAD_BYTES=10485760

# Comma-separated list of origins allowed to call the API (CORS).
LUMENOIR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- model / inference plumbing ------------------------------------------
# Empty means "no model selected". Selecting "zero_dce_plus_plus" loads the
# pretrained NoirNet checkpoint once at startup. The inference dependencies
# (torch, numpy) live in requirements-inference.txt; the API still boots
# without them and reports model_unavailable/torch_missing if selected.

# Registered model id (default: empty). "zero_dce_plus_plus" enables NoirNet
# when the inference dependencies and checkpoint are installed.
LUMENOIR_MODEL_ID=

# Explicit checkpoint path. Leave empty to use <weights_dir>/<model_id>.pth.
LUMENOIR_MODEL_WEIGHTS=

# Directory containing .pth checkpoints (default: backend/weights).
LUMENOIR_WEIGHTS_DIR=backend/weights

# Inference device: cpu (default), mps (Apple Silicon), cuda, cuda:N or auto.
# "auto" prefers MPS, then CUDA, then CPU. Explicit devices never fall back.
LUMENOIR_INFERENCE_DEVICE=cpu

# Zero-DCE++ downscale factor in [1, 12]. 12 matches the authors' test script.
LUMENOIR_ZERODCE_SCALE_FACTOR=12

# Longest edge used for inference (aspect ratio preserved, never upscaled).
LUMENOIR_INFERENCE_MAX_EDGE=1600

# Hard ceiling on inference pixels before a request is rejected.
LUMENOIR_INFERENCE_MAX_PIXELS=4000000

# Load weights once during startup (default: true).
LUMENOIR_LOAD_MODEL_ON_STARTUP=true
